# Server Settings
PORT=5000
NODE_ENV=development

# Frontend & Booth URL (Use your laptop's local IP or deployed domain for mobile QR scans)
CLIENT_URL=http://localhost:3000
BOOTH_PUBLIC_URL=http://localhost:3000

# Event Info
EVENT_NAME="DIDAC India 2026 - Bangalore"
BOOTH_NUMBER="Booth #E-42"
COMPANY_NAME="STEM-Xpert"
WEBSITE_URL="https://www.stem-xpert.com/in/home"
ACADEMY_URL="https://academy.stem-xpert.com/in/home"

# MongoDB Connection String (leave empty for automatic local storage fallback)
# Example: mongodb+srv://username:password@cluster0.xxx.mongodb.net/stem_xpert_didac?retryWrites=true&w=majority
MONGODB_URI=

# Email SMTP Settings (Optional - leave empty to simulate in development)
# For Gmail: host=smtp.gmail.com, port=587, user=your_email, pass=app_password
# For SendGrid: host=smtp.sendgrid.net, port=587, user=apikey, pass=SG.xxxx
# For Resend: host=smtp.resend.com, port=465, user=resend, pass=re_xxxx
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="STEM-Xpert Team <events@stem-xpert.com>"

